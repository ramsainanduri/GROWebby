# GROWebby environment example
# This file is auto-generated by ./install.sh based on your hardware.
# You can also copy this file to .env and adjust manually.
#
# Docker Hub base images:
#   ramsainanduri/growebby-base-backend-cpu:latest
#   ramsainanduri/growebby-base-backend-cuda:latest
#   ramsainanduri/growebby-base-backend-metal:latest
#   ramsainanduri/growebby-base-frontend:latest

# ── Engine & profile ─────────────────────────────────────────────────────────
# Set by install.sh based on detected hardware. Options:
#   linux-cpu          → CPU-only Linux (no GPU)
#   linux-nvidia-cuda  → NVIDIA GPU (Linux)
#   mac-opencl-native  → Apple Silicon with native OpenCL GROMACS
GROWEBBY_ENGINE=linux-cpu

# Docker Compose profile to activate. Must match GROWEBBY_ENGINE:
#   cpu   → linux-cpu
#   cuda  → linux-nvidia-cuda
#   (empty string) → mac-opencl-native (backend runs natively)
COMPOSE_PROFILES=cpu

# ── Base image (set by install.sh — do not change manually unless overriding) ─
# Used as the FROM base when building the backend container and the GROMACS
# engine container. Must be one of the Docker Hub images listed above.
BACKEND_BASE_IMAGE=ramsainanduri/growebby-base-backend-cpu:latest

# ── GROMACS settings ─────────────────────────────────────────────────────────
GROMACS_EXECUTION_MODE=backend-gmx-2026.2
GROMACS_BINARY=/usr/local/gromacs/bin/gmx
GROMACS_WORK_ROOT=/app/media/workspaces
GROWEBBY_MEDIA_ROOT=/app/media

# ── Django settings ──────────────────────────────────────────────────────────
# DJANGO_DEBUG=0 for normal runs. Use 1 only while developing the backend.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-this-to-a-long-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GROWEBBY_SERVE_MEDIA=1

# ── Default admin account ────────────────────────────────────────────────────
# Created automatically on first start. Override before first run if desired.
# GROWEBBY_ADMIN_USERNAME=admin
# GROWEBBY_ADMIN_EMAIL=admin@growebby.local
# GROWEBBY_ADMIN_PASSWORD=admin

# ── Validation runs (keep 0 for production) ──────────────────────────────────
GROWEBBY_ALLOW_VALIDATION_RUNS=0

# ── CUDA profile example (NVIDIA GPU) ────────────────────────────────────────
# GROWEBBY_ENGINE=linux-nvidia-cuda
# COMPOSE_PROFILES=cuda
# BACKEND_BASE_IMAGE=ramsainanduri/growebby-base-backend-cuda:latest
# GROMACS_EXECUTION_MODE=backend-gmx-2026.2
# GROMACS_BINARY=/usr/local/gromacs/bin/gmx

# ── Apple Silicon native OpenCL example ──────────────────────────────────────
# GROWEBBY_ENGINE=mac-opencl-native
# COMPOSE_PROFILES=
# BACKEND_BASE_IMAGE=ramsainanduri/growebby-base-backend-metal:latest
# GROMACS_EXECUTION_MODE=native-opencl
# GROMACS_BINARY=/opt/homebrew/bin/gmx
