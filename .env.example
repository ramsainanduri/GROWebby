# GROWebby environment example
# Copy this file to .env and adjust values for your workstation.

# Django should be 0 for normal/production-style runs.
# Use 1 only while developing the backend.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-this-to-a-long-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GROWEBBY_SERVE_MEDIA=1

# Default Apple Silicon-safe path: GROMACS 2026.2 runs in the backend Docker
# container with CPU/OpenMP support.
GROWEBBY_ENGINE=docker-backend-cpu
GROMACS_EXECUTION_MODE=backend-gmx-2026.2
GROMACS_BINARY=/usr/local/gromacs/bin/gmx
GROMACS_WORK_ROOT=/app/media/workspaces

# Keep disabled for production analyses. Enable only for interface validation
# without a GROMACS executable.
GROWEBBY_ALLOW_VALIDATION_RUNS=0

# Native Apple Silicon GPU path. Uncomment these after installing a native
# OpenCL-enabled GROMACS build on macOS and running ./install.sh.
# GROWEBBY_ENGINE=mac-opencl-native
# GROMACS_EXECUTION_MODE=native-opencl
# GROMACS_BINARY=/opt/homebrew/bin/gmx
